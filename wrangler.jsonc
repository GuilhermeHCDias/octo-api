{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "octo-api",
	"main": "src/index.ts",
	"preview_urls": false,
	"compatibility_date": "2026-11-13",
	"observability": {
		"enabled": true
	},
	// No database_id or bucket_name: local dev and the tests use the local
	// simulation, and Wrangler provisions the resources on the first deploy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "9926c870-9df0-460d-ae27-bbfb293227c4"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "octo-releases"
		}
	],
	// Names only, never values. Local values live in .dev.vars (the README
	// lists them); deployed ones are set with `wrangler secret put`.
	"secrets": {
		"required": [
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"CHECKOUT_SUCCESS_URL",
			"CHECKOUT_CANCEL_URL"
		]
	}
}
